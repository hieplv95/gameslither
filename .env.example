# Sao chép thành file .env rồi điền giá trị thật. KHÔNG đưa file .env lên git.

# Trang quản trị /admin — tên đăng nhập (mặc định: admin)
ADMIN_USER=admin
# Mật khẩu ban đầu. Để trống = dùng mật khẩu mặc định 12345678 và bị buộc đổi ở lần đăng nhập đầu.
# Sau khi đổi mật khẩu trong trang quản trị, mật khẩu mới được lưu (dạng băm) trong cơ sở dữ liệu và dòng này không còn tác dụng.
# ADMIN_PASSWORD=

# Tên miền thật của website (dùng cho thẻ canonical, sitemap…)
# SITE_URL=https://tenmien.vn

# PAID_MODE=1   # bật chế độ chơi mất phí
# FOOD_MULT=2   # hệ số lượng mồi trên bản đồ (1 = 2200 viên/phòng miễn phí, 2 = 4400; từ 0.5 đến 5)

# ---- Blog: công cụ viết bài tự động trong /admin → tab Blog
# Bắt buộc để AI viết bài (lấy tại https://console.anthropic.com → API Keys)
# ANTHROPIC_API_KEY=sk-ant-...
# Model viết bài (mặc định claude-opus-5)
# BLOG_MODEL=claude-opus-5
# Ảnh cho bài viết — chọn 1 trong 2 (không có thì chỉ tạo ảnh bìa đơn giản tự vẽ):
#   OPENAI_API_KEY: AI vẽ ảnh minh hoạ riêng cho từng bài (tính phí theo từng ảnh — xem bảng giá OpenAI)
#   PEXELS_API_KEY: ảnh chụp kho miễn phí từ pexels.com/api (có ghi nguồn)
# OPENAI_API_KEY=sk-...
# OPENAI_IMAGE_MODEL=gpt-image-1
# PEXELS_API_KEY=...
# Thư mục lưu ảnh blog (mặc định ./media)
# MEDIA_DIR=
